# Only required if config.yaml's background_mode is changed to "supplied" or "mixed",
# i.e. an external image-generation API is used for slide backgrounds. Not used by the
# test batch (background_mode: generated — Pillow-only, no API calls, no cost).

IMAGE_API_PROVIDER=
IMAGE_API_KEY=

# Only required for scripts/instagram_publish.py (automated posting). Setup requires your
# own Meta/Facebook login — see the header comment in that script for the exact steps.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
# Public HTTPS base URL mirroring 03_generated_posts/ — the Graph API downloads images by
# URL, not from your local disk, so the PNGs need to be hosted somewhere reachable.
PUBLIC_IMAGE_BASE_URL=
